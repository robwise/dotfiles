# The Eisvogel pandoc template, pinned to the release in .chezmoidata/packages.toml.
# A new version is a new URL, so chezmoi downloads it on the next apply.
[".local/share/pandoc/templates/eisvogel.latex"]
    type = "archive-file"
    url = "https://github.com/Wandmalfarbe/pandoc-latex-template/releases/download/v{{ .eisvogel.version }}/Eisvogel-{{ .eisvogel.version }}.tar.gz"
    path = "Eisvogel-{{ .eisvogel.version }}/eisvogel.latex"
