{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Install the source checkout's pre-commit hook, which runs
# scripts/check-docs.py. Runs after 30-install-packages provides uv and the
# Brewfile's pre-commit.
: "${CHEZMOI_SOURCE_DIR:?chezmoi sets CHEZMOI_SOURCE_DIR for run files}"

export PATH="/opt/homebrew/bin:$PATH"
PATH="$(uv --color never tool dir --bin):$PATH"

cd "$CHEZMOI_SOURCE_DIR"
pre-commit install
{{ end -}}
